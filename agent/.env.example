# Copy to .env and fill in. .env is gitignored; never commit real tokens.
#
#   cp .env.example .env
#
# TabPFN API key, from https://ux.priorlabs.ai/account
# TABPFN_TOKEN is the name the official SDKs read: tabpfn_client/constants.py
# and tabpfn/browser_auth.py both look up exactly this variable. Do not rename.
# Each team member should register their own rather than sharing one, so the
# account rate limit is not pooled.
TABPFN_TOKEN=

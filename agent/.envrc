# Safe to commit: contains no secrets, only loads the gitignored .env.
# Requires direnv (`brew install direnv`); run `direnv allow` once in this directory.
dotenv_if_exists .env

# Also point uv at the same file, so `uv run` loads it even from a subdirectory.
# expand_path makes this absolute (relative to this .envrc), because UV_ENV_FILE
# is otherwise resolved against the current working directory.
export UV_ENV_FILE="$(expand_path .env)"
